{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.0",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "league/commonmark": "^2.10",
        "myclabs/php-enum": "^1.8",
        "romanzipp/dto": "^2.3",
        "romanzipp/laravel-dto": "^1.1",
        "romanzipp/laravel-previously-deleted": "^1.7",
        "romanzipp/laravel-queue-monitor": "^5.4",
        "romanzipp/laravel-seo": "^2.9",
        "romanzipp/laravel-turnstile": "^1.4",
        "socialiteproviders/apple": "^6.0",
        "socialiteproviders/google": "^4.1",
        "socialiteproviders/twitter": "^4.1",
        "spatie/laravel-medialibrary": "^11.23"
    },
    "require-dev": {
        "brianium/paratest": "^7.8",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0",
        "romanzipp/laravel-env-normalizer": "^1.3",
        "romanzipp/laravel-model-doc": "^3.4",
        "romanzipp/php-cs-fixer-config": "^3.3",
        "spatie/laravel-ignition": "^2.12"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/App",
            "Domain\\": "app/Domain",
            "Support\\": "app/Support",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "format": [
            "php-cs-fixer fix"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
